{
  "expo": {
    "name": "Steady CDL",
    "slug": "steady-cdl",
    "scheme": "steadycdl",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.mindmelding.steadycdl",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.mindmelding.steadycdl"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-font"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
