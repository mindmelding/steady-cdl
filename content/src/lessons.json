    "title": "Low air warnings",
    "minutes": 4,
    "why": "Your truck warns you when air pressure in the service tank gets low. Knowing the warning point tells you when to act.",
    "key_facts": [
      {
        "label": "Warning comes on",
        "text": "Before service reservoir pressure falls below 60 psi, or half the governor cut-out pressure if that is lower",
        "citation": {
          "doc": "49 CFR",
          "locator": "393.51",
          "url": "https://www.ecfr.gov/current/title-49/section-393.51"
        }
      },
      {
        "label": "Which number applies",
        "text": "The lower of the two",
        "citation": {
          "doc": "49 CFR",
          "locator": "393.51",
          "url": "https://www.ecfr.gov/current/title-49/section-393.51"
        }
